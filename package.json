{
  "name": "chess-game-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Simple chess game, built with Bun, React, Tailwind CSS and TypeScript",
  "keywords": [
    "chess",
    "game",
    "bun",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "author": "Marcelo Knob",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "lint": "biome check --unsafe --write"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
