{
  "name": "chess-game-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Simple chess game, built with Bun, React, Tailwind CSS and TypeScript",
  "keywords": [
    "chess",
    "game",
    "bun",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "author": "Marcelo Knob",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.html",
    "start": "NODE_ENV=production bun src/index.html",
    "build": "bun run build.ts",
    "lint": "biome check --unsafe --write"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.532.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.6",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  }
}
